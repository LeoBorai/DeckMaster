{
  "openapi": "3.1.0",
  "info": {
    "title": "DeckMaster API",
    "description": "API for MTG cards and decks",
    "contact": {
      "name": "API Support",
      "email": "hi@leoborai.com"
    },
    "license": {
      "name": ""
    },
    "version": "0"
  },
  "servers": [
    {
      "url": "http://localhost:7878",
      "description": "Local development server"
    },
    {
      "url": "https://api.deckmaster.leoborai.com",
      "description": "Production server"
    }
  ],
  "paths": {
    "/api/v0/mtg/cards": {
      "get": {
        "tags": [
          "cards"
        ],
        "operationId": "handler",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number (starts from 1)",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32",
              "minimum": 1
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "List of MTG Cards",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Card"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/mtg/decks": {
      "get": {
        "tags": [
          "decks"
        ],
        "summary": "Get all Decks with filtering",
        "operationId": "handler",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number (starts from 1)",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32",
              "minimum": 1
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "List of MTG Decks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Deck"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ],
            "description": "Error code for client handling",
            "example": "NOT_FOUND"
          },
          "message": {
            "type": "string",
            "description": "Error message",
            "example": "Error message"
          }
        }
      },
      "Card": {
        "type": "object",
        "required": [
          "id",
          "title",
          "number",
          "kind",
          "rarity",
          "deckId"
        ],
        "properties": {
          "artist": {
            "type": [
              "string",
              "null"
            ],
            "example": "Sergei Leoluch Panin"
          },
          "deckId": {
            "type": "string",
            "format": "uuid",
            "example": "123e4567-e89b-12d3-a456-426614174003"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "example": "Whenever The Wise Mothman enters the battlefield or attacks, each player gets a rad counter."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "123e4567-e89b-12d3-a456-426614174003"
          },
          "kind": {
            "type": "string",
            "example": "Legendary Creature — Insect Mutant"
          },
          "mana": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "example": "1, B, G, U"
          },
          "number": {
            "type": "integer",
            "format": "int64",
            "example": "0004"
          },
          "power": {
            "type": [
              "string",
              "null"
            ],
            "example": "3"
          },
          "rarity": {
            "type": "string",
            "example": "M"
          },
          "title": {
            "type": "string",
            "example": "The Wise Mothman"
          },
          "toughness": {
            "type": [
              "string",
              "null"
            ],
            "example": "3"
          }
        }
      },
      "Deck": {
        "type": "object",
        "required": [
          "id",
          "name",
          "code",
          "release"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "PIP"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "123e4567-e89b-12d3-a456-426614174003"
          },
          "name": {
            "type": "string",
            "example": "Fallout"
          },
          "release": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-01T00:00:00Z"
          }
        }
      },
      "PaginatedResponse_Card": {
        "type": "object",
        "required": [
          "page",
          "total",
          "totalPages",
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "number",
                "kind",
                "rarity",
                "deckId"
              ],
              "properties": {
                "artist": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "example": "Sergei Leoluch Panin"
                },
                "deckId": {
                  "type": "string",
                  "format": "uuid",
                  "example": "123e4567-e89b-12d3-a456-426614174003"
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "example": "Whenever The Wise Mothman enters the battlefield or attacks, each player gets a rad counter."
                },
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "example": "123e4567-e89b-12d3-a456-426614174003"
                },
                "kind": {
                  "type": "string",
                  "example": "Legendary Creature — Insect Mutant"
                },
                "mana": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  },
                  "example": "1, B, G, U"
                },
                "number": {
                  "type": "integer",
                  "format": "int64",
                  "example": "0004"
                },
                "power": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "example": "3"
                },
                "rarity": {
                  "type": "string",
                  "example": "M"
                },
                "title": {
                  "type": "string",
                  "example": "The Wise Mothman"
                },
                "toughness": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "example": "3"
                }
              }
            }
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "PaginatedResponse_Deck": {
        "type": "object",
        "required": [
          "page",
          "total",
          "totalPages",
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "code",
                "release"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "example": "PIP"
                },
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "example": "123e4567-e89b-12d3-a456-426614174003"
                },
                "name": {
                  "type": "string",
                  "example": "Fallout"
                },
                "release": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2024-01-01T00:00:00Z"
                }
              }
            }
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "cards",
      "description": "Cards details retrieval endpoints"
    },
    {
      "name": "decks",
      "description": "Decks details retrieval endpoints"
    }
  ]
}
